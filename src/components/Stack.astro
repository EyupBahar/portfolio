---
/**
 * Stack als Laufband im Glas-Panel (Joker 2026-11-12: „Stack kısmını slider haline getir", gewählt „kayan şerit";
 * DESIGN.md → Signatur 4). Ausbildung & Zertifikate entfernt (Joker, gleicher Auftrag) – der Stack hat die ganze Breite.
 *   – Die zwölf Werkzeuge laufen von selbst; jede Marke in Silber (Joker „Silber als Material", Krom-Umbau),
 *     Name darunter. Seit 2026-11-12 (Joker) ohne Kachel- und Panel-Rahmen: das Glas läuft ringsum weich in den
 *     dunklen Grund aus (::before mit radialer Mask) statt als Rechteck zu enden.
 *   – Technik aus design-blocks `yorum--akis` (gemessen, P13), wie das erste Laufband vom 2026-11-09: Spur
 *     `width: max-content` + `translateX(0 → -50%)` linear endlos, zweite Kopie `aria-hidden`, Ränder per Mask
 *     ausgeblendet. Hält bei Hover und Fokus; Pause-Taste (slider README: Autoplay nur mit Pause-Kontrolle,
 *     WCAG 2.2.2) – ohne JS bleibt sie `hidden`, das Band läuft und hält bei Hover/Fokus.
 *   – `prefers-reduced-motion`: keine Bewegung, Kopie weg, das Band scrollt von Hand.
 * Messspur-Segment 2 und Sprungmarke `stack` bleiben (Messprotokoll-Eintrag „Stack").
 */
import { Icon } from 'astro-icon/components';
import { t, anchors, type Lang } from '../i18n/ui';
import Messspur from './Messspur.astro';
import { stack } from '../data/stack';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="stack section mess-bereich" id={anchors[lang].stack} aria-labelledby="stack-title">
  <Messspur teil="segment" index={2} />
  <div class="container">
    <h2 class="section-title" id="stack-title">{t(lang, 'stack.title')}</h2>
    <div class="panel stack__panel">
      <div class="stack__band" role="group" tabindex="0" aria-label={t(lang, 'stack.bandLabel')}>
        <ul class="stack__track" role="list">
          {[false, true].map((dup) =>
            stack.map((s) => (
              <li class="stack__eintrag" aria-hidden={dup ? 'true' : undefined} data-dup={dup ? '' : undefined}>
                <span class="stack__kachel" aria-hidden="true"><Icon name={s.icon} class="stack__mark" /></span>
                <span class="stack__name">
                  {s.label}
                  {'note' in s && <span class="mono stack__note">{t(lang, s.note)}</span>}
                </span>
              </li>
            )),
          )}
        </ul>
      </div>
      <button class="stack__pause" type="button" aria-pressed="false" aria-label={t(lang, 'stack.pause')} hidden>
        <Icon name="ph:pause" class="stack__ico stack__ico--pause" aria-hidden="true" />
        <Icon name="ph:play" class="stack__ico stack__ico--play" aria-hidden="true" />
      </button>
    </div>
  </div>
</section>

<script>
  // K1, ~10 Zeilen: die Pause-Taste wird erst mit JS sichtbar und schaltet `is-paused` am Abschnitt;
  // der Zustand steht in `aria-pressed`, der Name der Taste bleibt gleich (Toggle-Button).
  for (const root of document.querySelectorAll<HTMLElement>('.stack')) {
    const btn = root.querySelector<HTMLButtonElement>('.stack__pause');
    if (!btn) continue;
    btn.hidden = false;
    btn.addEventListener('click', () => {
      const paused = root.classList.toggle('is-paused');
      btn.setAttribute('aria-pressed', String(paused));
    });
  }
</script>

<style>
  .stack {
    /* Slot pro Werkzeug 136 → 208 px (frontend-design §2, rem-Term Pflicht); feste Breite statt Anzahl pro Seite,
     * weil das Band kontinuierlich läuft – der Mask-Rand blendet die angeschnittene Marke aus. */
    --stack-kart: clamp(8.5rem, 6.829rem + 6.857vw, 13rem);
    /* Eine Runde (12 Slots) in 50 s: ~50 px/s am Desktop, ~33 px/s am Telefon – ruhig, aber sichtbar. */
    --stack-dauer: 50s;
  }

  /* Panel: Band links bis an den Rand (die Mask löst es dort auf), rechts die Pause-Taste */
  .stack__panel {
    display: flex;
    align-items: center;
    gap: 1rem;
    padding: var(--panel-pad) var(--panel-pad) var(--panel-pad) 0;
  }
  /* Ohne Rahmen, Glas mit weichem Rand (Joker 2026-11-12: „border'ları kaldır, siyah bg ile belirsiz bir geçiş").
   * Rahmen und Fläche von global .panel hier aus (Scoping-Spezifität 0-2-0 > 0-1-0); das Glas sitzt auf ::before,
   * damit die Mask nur die Fläche ausblendet, nicht das Band. Mitte voll (bis 45 %), zu allen Rändern hin aus. */
  .stack__panel {
    position: relative;
    isolation: isolate;
    border: 0;
    background: none;
  }
  .stack__panel::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--glass);
    -webkit-mask-image: radial-gradient(closest-side, #000 45%, transparent);
    mask-image: radial-gradient(closest-side, #000 45%, transparent);
    pointer-events: none;
  }
  /* < 768 px: Taste unter das Band (rechts), sonst blieben dem Band neben ihr nur ~2 Slots */
  @media (max-width: 47.99rem) {
    .stack__panel {
      flex-direction: column;
      align-items: stretch;
      gap: 0.75rem;
      padding-inline: 0;
    }
    .stack__band { width: 100%; }
    .stack__pause { align-self: flex-end; margin-inline-end: var(--panel-pad); }
  }

  /* Band: Ränder lösen sich auf, die Spur läuft darunter durch */
  .stack__band {
    flex: 1;
    min-width: 0;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 6%, #000 94%, transparent);
  }
  .stack__track {
    display: flex;
    width: max-content;
    margin: 0;
    padding: 0;
    list-style: none;
    animation: stack-drift var(--stack-dauer) linear infinite;
    will-change: transform;
  }
  @keyframes stack-drift {
    from { transform: translateX(0); }
    to   { transform: translateX(-50%); }
  }
  /* P13 / marquee-width: Slot-Breite als `width` am Kind der Spur, nie nur flex-basis – WebKit misst die
   * max-content-Spur sonst aus dem einzeiligen Text und das Band liefe in Safari 2–4x zu schnell. */
  .stack__track > * {
    flex: none;
    width: var(--stack-kart);
  }

  /* Halten: Hover (nur echte Zeiger, sonst klebt :hover nach dem Tippen), Fokus im Band, Pause-Taste */
  @media (hover: hover) and (pointer: fine) {
    .stack__band:hover .stack__track { animation-play-state: paused; }
  }
  .stack__band:focus-within .stack__track,
  .stack.is-paused .stack__track { animation-play-state: paused; }

  /* Eintrag: Kachel oben, Name darunter, mittig */
  .stack__eintrag {
    display: grid;
    justify-items: center;
    align-content: start;
    gap: 0.85rem;
    padding-inline: 0.5rem;
    text-align: center;
  }
  /* Kachel: nur noch der Platz des Zeichens (Rahmen entfernt, Joker 2026-11-12), Zeichen in Silber */
  .stack__kachel {
    display: grid;
    place-items: center;
    width: clamp(3.5rem, 3rem + 1.5vw, 4.5rem);
    height: clamp(3.5rem, 3rem + 1.5vw, 4.5rem);
  }
  .stack__mark {
    width: 50%;
    height: 50%;
    color: var(--ink);
  }
  .stack__name {
    display: grid;
    justify-items: center;
    gap: 0.15rem;
    font-size: var(--step-caption);
    line-height: 1.3;
    overflow-wrap: anywhere;
  }
  .stack__note { color: var(--ink-soft); font-size: 0.75rem; }

  /* Pause-Taste: Hairline-Quadrat ≥ 44 px, kein Grund, Hover = Fläche eine Stufe heller */
  .stack__pause {
    display: grid;
    flex: none;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    padding: 0;
    border: 1px solid var(--hairline-strong);
    background: transparent;
    color: var(--ink);
    cursor: pointer;
    transition: background-color var(--dur-fast) var(--ease);
  }
  .stack__pause[hidden] { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .stack__pause:hover { background: var(--band); }
  }
  .stack__ico { width: 1.25rem; height: 1.25rem; }
  .stack__ico--play { display: none; }
  .stack.is-paused .stack__ico--pause { display: none; }
  .stack.is-paused .stack__ico--play { display: block; }

  /* Reduce: keine Bewegung – das Band steht, die Kopie ist weg, es scrollt von Hand (Fokus per tabindex) */
  @media (prefers-reduced-motion: reduce) {
    .stack__panel { padding-inline: var(--panel-pad); } /* ohne Mask stünde die erste Kachel am Rand */
    .stack__band { overflow-x: auto; -webkit-mask-image: none; mask-image: none; }
    .stack__track { animation: none; will-change: auto; }
    .stack__track > [data-dup] { display: none; }
    .stack__pause { display: none; }
  }
</style>
