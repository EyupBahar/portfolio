---
/**
 * Schwerpunkte als Wendekarten (Joker 2026-11-12: „kartların hepsini eşit yap, kartta sadece logo ortada,
 * hover'da arka tarafına dönsün, açıklamalar arkada"): drei gleich breite, gleich hohe Karten. Vorderseite nur
 * das Icon, gross und mittig; Rückseite Titel, Text und Stack-Zeile. Titel/Text/Indikatorlinie aus dem Block
 * card--numarali (Klassen einzeln, die Karte selbst ist keine .db-card-num mehr – deren :hover-Regeln
 * würden die gedrehte Rückseite zurückdrehen). Kein Block in design-blocks hat eine Wendekarte.
 *
 * Dreht bei: Maus-Hover (nur ab 1024 px), Tastaturfokus (Tab, deshalb tabindex) und in der Mobil-Ansicht
 * (hover: none oder < 1024 px) nur per Antippen/Klick (:focus; Joker 2026-11-13 „mobilde kartın arkasına dönmesi
 * için tıklanması gereksin" – vorher drehte < 1024 px schon das Überfahren mit der Maus). Reines CSS, das Zurückdrehen
 * per K1-Skript unten. Reduce: keine Drehung, die Seiten wechseln ohne Bewegung.
 * Screenreader lesen die Rückseite immer (backface-visibility verbirgt nur das Bild); die Vorderseite ist
 * reine Grafik und aria-hidden.
 */
import { Icon } from 'astro-icon/components';
import { t, anchors, type Lang, type UiKey } from '../i18n/ui';
import Messspur from './Messspur.astro';
import { focus } from '../data/focus';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<section class="focus section mess-bereich" id={anchors[lang].focus} aria-labelledby="focus-title">
  <Messspur teil="segment" index={1} />
  <div class="container">
    <h2 class="section-title" id="focus-title">{t(lang, 'focus.title')}</h2>
    <div class="focus__grid">
      {focus.map((f) => (
        <article class="focus-karte" tabindex="0" aria-labelledby={`focus-${f.key}`}>
          <div class="focus-karte__dreh">
            <div class="focus-karte__seite focus-karte__seite--vorn" aria-hidden="true">
              <Icon name={f.icon} class="focus-karte__logo" />
            </div>
            <div class="focus-karte__seite focus-karte__seite--hinten">
              <span class="db-card-num__bar" aria-hidden="true"></span>
              <h3 class="db-card-num__title" id={`focus-${f.key}`}>{t(lang, `focus.${f.key}.title` as UiKey)}</h3>
              <p class="db-card-num__desc">{t(lang, `focus.${f.key}.text` as UiKey)}</p>
              <ul class="mono focus__stack" role="list" aria-label={t(lang, 'stack.title')}>
                {f.stack.map((s) => <li>{s}</li>)}
              </ul>
            </div>
          </div>
          <span class="focus-karte__hinweis" aria-hidden="true">
            <Icon name="ph:arrow-clockwise-light" class="focus-karte__hinweis-icon" />
          </span>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  /* Raster: alle Karten gleich breit und gleich hoch (1fr-Zeilen = höchste Rückseite).
   * Drei Spalten erst ab 1024 px – bei 768 px bliebe für den Text der Rückseite ~160 px Breite. */
  .focus__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-auto-rows: 1fr;
    gap: var(--panel-gap);
  }
  @media (min-width: 1024px) {
    .focus__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* Zustand „gedreht" an EINER Stelle, als Variablen: Maus-Hover, Tastaturfokus, Antippen (Touch).
   * Die Karte selbst dreht sich nie – nur .focus-karte__dreh –, so bleibt die Hover-Fläche stabil,
   * auch wenn die drehende Fläche bei 90° zur Linie wird (sonst Flackern). */
  .focus-karte {
    --gedreht: 0;
    --rand: var(--glass-edge);
    --rand-oben: var(--glass-light);
    display: grid;
    perspective: 1400px;
  }
  /* Mobil-Ansicht = dieselbe Bedingung wie der Dreh-Hinweis: dort dreht nur Antippen/Klick (:focus), nie Hover */
  @media (hover: hover) and (min-width: 1024px) {
    .focus-karte:hover {
      --gedreht: 1;
      --rand: var(--accent);
      --rand-oben: var(--accent);
    }
  }
  .focus-karte:focus-visible {
    --gedreht: 1;
    --rand: var(--accent);
    --rand-oben: var(--accent);
  }
  @media (hover: none), not all and (min-width: 1024px) {
    .focus-karte { cursor: pointer; }
    .focus-karte:focus {
      --gedreht: 1;
      --rand: var(--accent);
      --rand-oben: var(--accent);
    }
  }

  .focus-karte__dreh {
    grid-area: 1 / 1; /* explizit: sonst setzt das Auto-Placement es unter den Dreh-Hinweis in Zeile 2 */
    display: grid;
    transform-style: preserve-3d;
    transform: rotateY(calc(var(--gedreht) * 180deg));
    transition: transform 0.6s var(--ease);
  }

  /* Beide Seiten liegen in derselben Rasterzelle; die höhere bestimmt die Kartenhöhe.
   * Fläche wie .panel (Glas, Joker 2026-11-12); Ecken 0. */
  .focus-karte__seite {
    grid-area: 1 / 1;
    position: relative; /* für die Indikatorlinie */
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
    min-height: 17rem;
    padding: 2rem;
    border: 1px solid var(--rand);
    border-top-color: var(--rand-oben);
    border-radius: 0;
    background: var(--glass);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
    transition: border-color var(--dur) var(--ease);
  }
  /* Vorderseite: nur das Icon, in beiden Achsen mittig. Eigenes rotateY(0), damit WebKit die
   * Rückseite der Vorderseite sicher ausblendet. */
  .focus-karte__seite--vorn {
    align-items: center;
    justify-content: center;
    transform: rotateY(0deg);
  }
  .focus-karte__seite--hinten { transform: rotateY(180deg); }

  /* Icon: Jokers Zeichnungen, 6–8rem (vorher 4rem; Joker 2026-11-12 „logoları büyüt"), Silber (Joker 2026-11-12
   * „kartlar gümüş olsun"; wie die Tasten: Silber als Material, Stahlblau nur als Indikator beim Drehen) */
  .focus-karte__logo {
    display: block;
    width: clamp(6rem, 4.5rem + 4vw, 8rem);
    height: clamp(6rem, 4.5rem + 4vw, 8rem);
    color: var(--ink);
  }

  /* Indikatorlinie oben auf der Rückseite: zieht sich nach der Drehung auf (Block: bei Hover).
   * Eigenes backface-visibility: Safari legt ein transformiertes Kind in eine eigene Ebene, die das
   * hidden der Seite nicht erbt – sonst blitzt die Linie beim Zurückdrehen gespiegelt auf. */
  .focus-karte .db-card-num__bar {
    transform: scaleX(var(--gedreht));
    transition-delay: calc(var(--gedreht) * 0.3s);
    -webkit-backface-visibility: hidden;
    backface-visibility: hidden;
  }

  /* Dreh-Hinweis (Joker 2026-11-13, futuristic-design): in der Mobil-Ansicht – ohne Maus-Hover ODER unter 1024 px –
   * zeigt ein ↻ oben rechts, dass die Karte sich dreht. Er liegt AUSSERHALB von .focus-karte__dreh: so dreht er
   * nicht mit, und Safari zeichnet ihn nicht durch das backface-visibility der Seite hindurch (animiertes Kind =
   * eigene Ebene, vgl. Indikatorlinie). Bewegung: langsame volle Drehung in der Ebene (360°), dann Ruhe;
   * Farbe `--ink` wie das Logo (Joker 2026-11-13 „beyaz olsun ve 360 derece dönsün"; vorher Stahlblau + Y-Achse).
   * Gedreht: blendet sofort aus; zurück: erscheint erst gegen Ende der Rückdrehung (0.6 s). */
  .focus-karte__hinweis {
    display: none;
  }
  @media (hover: none), not all and (min-width: 1024px) {
    .focus-karte__hinweis {
      grid-area: 1 / 1;
      justify-self: end;
      align-self: start;
      position: relative;
      z-index: 1;
      display: block;
      margin: 1rem;
      color: var(--ink);
      pointer-events: none;
      opacity: calc(1 - var(--gedreht));
      transition: opacity var(--dur) var(--ease);
      transition-delay: calc((1 - var(--gedreht)) * 0.45s);
    }
  }
  .focus-karte__hinweis-icon {
    display: block;
    width: 1.75rem;
    height: 1.75rem;
    animation: focus-hinweis-drehen 6s cubic-bezier(0.45, 0, 0.55, 1) infinite;
  }
  /* 6 s je Runde: 1.8 s Ruhe, 2.4 s Drehung, 1.8 s Ruhe */
  @keyframes focus-hinweis-drehen {
    0%,
    30% {
      transform: rotate(0deg);
    }
    70%,
    100% {
      transform: rotate(360deg);
    }
  }

  .focus__stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin-top: auto; /* Stack-Zeile sitzt am unteren Rand, auch wenn der Text kürzer ist */
    padding-top: 0.5rem;
    color: var(--ink-soft);
  }

  /* Reduce: keine Drehung – die Rückseite liegt ungedreht obenauf und wird nur sichtbar geschaltet */
  @media (prefers-reduced-motion: reduce) {
    .focus-karte__dreh {
      transform: none;
      transition: none;
    }
    .focus-karte__seite { transition: none; }
    .focus-karte__seite--vorn { opacity: calc(1 - var(--gedreht)); }
    .focus-karte__seite--hinten {
      transform: none;
      opacity: var(--gedreht);
    }
    .focus-karte .db-card-num__bar { transition: none; }
    /* Hinweis bleibt als ruhendes Zeichen stehen */
    .focus-karte__hinweis { transition: none; }
    .focus-karte__hinweis-icon { animation: none; }
  }
</style>

<script>
  // K1: Touch dreht per :focus (CSS, geht auch ohne JS). Ohne Hilfe bliebe die Karte gedreht, bis eine
  // andere den Fokus nimmt – Antippen daneben fokussiert in WebKit nichts. Deshalb: zweites Antippen
  // derselben Karte oder Antippen ausserhalb dreht zurück (blur). In der Mobil-Ansicht (< 1024 px) gilt dasselbe
  // für Mausklicks; ab 1024 px bleiben Maus (Hover) und Tastatur unberührt.
  const mobil = window.matchMedia('(hover: none), not all and (min-width: 1024px)');
  let gedrehtBeimDruck: HTMLElement | null = null;
  document.addEventListener(
    'pointerdown',
    (e) => {
      if (e.pointerType === 'mouse' && !mobil.matches) return;
      const aktiv = document.activeElement;
      const offen = aktiv instanceof HTMLElement && aktiv.matches('.focus-karte') ? aktiv : null;
      const karte = e.target instanceof Element ? e.target.closest<HTMLElement>('.focus-karte') : null;
      gedrehtBeimDruck = offen && karte === offen ? offen : null;
      if (offen && !karte) offen.blur();
    },
    { passive: true },
  );
  document.addEventListener('click', (e) => {
    const karte = e.target instanceof Element ? e.target.closest<HTMLElement>('.focus-karte') : null;
    if (karte && karte === gedrehtBeimDruck) karte.blur();
    gedrehtBeimDruck = null;
  });
</script>
