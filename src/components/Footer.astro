---
import { Icon } from 'astro-icon/components';
import { t, routes, type Lang } from '../i18n/ui';
import { profile } from '../data/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner mono">
    <p>© {year} {profile.name}</p>
    <ul class="site-footer__links" role="list">
      <li><a href={routes.privacy[lang]}>{t(lang, 'footer.privacy')}</a></li>
      <li><a class="site-footer__kachel" href={profile.github.url} rel="noopener noreferrer" aria-label="GitHub"><Icon name="ph:github-logo-light" aria-hidden="true" /></a></li>
      <li><a class="site-footer__kachel" href={profile.linkedin.url} rel="noopener noreferrer" aria-label="LinkedIn"><Icon name="ph:linkedin-logo-light" aria-hidden="true" /></a></li>
    </ul>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--hairline);
    color: var(--ink-soft);
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem var(--gap);
    padding-block: 1.5rem;
  }
  .site-footer__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 1rem;
  }
  .site-footer__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.75rem;
    text-decoration: none;
  }
  /* GitHub/LinkedIn als Hairline-Kachel (Joker 2026-11-12, Referenz „Digital Designer"): 44 px Ziel,
   * Name als aria-label; Hover = Rahmen und Zeichen im Indikator Stahlblau */
  .site-footer__links .site-footer__kachel {
    justify-content: center;
    width: 2.75rem;
    height: 2.75rem;
    border: 1px solid var(--hairline-strong);
    color: var(--ink);
    transition: color var(--dur-fast) var(--ease), border-color var(--dur-fast) var(--ease);
  }
  .site-footer__kachel :global(svg) { width: 1.25rem; height: 1.25rem; }
  @media (hover: hover) and (pointer: fine) {
    .site-footer__links a:hover { color: var(--ink); text-decoration: underline; }
    .site-footer__links .site-footer__kachel:hover { color: var(--accent); border-color: var(--accent); text-decoration: none; }
  }
  .site-footer__kachel:focus-visible { color: var(--accent); }
</style>
