---
/**
 * CTA-Band vor dem Kontakt: eine Zeile, die gefüllte Taste (Lebenslauf) und ein Textlink zur
 * Kontakt-Tafel. Ersetzt das Formular der Referenz – kein Backend, keine Angriffsfläche.
 * Text ist Entwurf (ui.ts cta.text), hängt am offenen Punkt „Status" in CLAUDE.md.
 */
import { Icon } from 'astro-icon/components';
import { t, anchors, type Lang } from '../i18n/ui';
import { profile } from '../data/profile';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div class="cta section">
  <div class="container">
    <div class="panel cta__panel">
      {/* Vorerst ausgeblendet (Joker 2026-11-09) – zum Einblenden Kommentar entfernen; Text in ui.ts cta.text.
          Gleiche Zeile in scripts/geo.mjs mit einkommentieren.
      <p class="cta__text">{t(lang, 'cta.text')}</p>
      */}
      <div class="cta__actions">
        <a class="db-btn db-btn--dolu" href={profile.cv[lang]} type="application/pdf">
          <Icon name="ph:identification-card" class="db-btn__icon db-btn__icon--lead" aria-hidden="true" />
          <span class="db-btn__label">{t(lang, 'hero.cv')}</span>
        </a>
        <a class="db-btn db-btn--cizgi cta__contact" href={`#${anchors[lang].contact}`}>
          <span class="db-btn__label">{t(lang, 'cta.contact')}</span>
          <Icon name="ph:arrow-down" class="db-btn__icon" aria-hidden="true" />
        </a>
      </div>
    </div>
  </div>
</div>

<style>
  .cta__panel {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    padding: var(--panel-pad);
  }
  .cta__text {
    max-width: 28ch;
    font-size: var(--step-3);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.02em;
  }
  .cta__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.5rem;
  }
  .cta__contact { --db-b: var(--ink); }
  /* Der Pfeil zeigt nach unten – also auch dorthin gleiten, nicht nach rechts */
  .cta__contact:hover .db-btn__icon { transform: translateY(0.28em); }
  @media (max-width: 767px), (any-pointer: coarse) {
    .cta .db-btn { min-height: 2.75rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .cta__contact:hover .db-btn__icon { transform: none; }
  }
</style>
