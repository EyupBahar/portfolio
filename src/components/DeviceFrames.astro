---
/**
 * Geräte-Komposition der Projektliste (Joker, 2026-11-09): iMac 24" hinten, iPhone 17 Pro Max
 * vorne rechts, überlappend. Flach gezeichnet – eloxiertes Gehäuse, Hairlines, keine Schatten,
 * kein Bild-Mockup. Alle Masse in % der Breite → skaliert mit der Spalte, ohne Breakpoint.
 *
 * Proportionen (Apple-Datenblätter): iMac 24" 54.7 cm breit, Glasrand ≈ 1.35 cm, Display 16:9;
 * iPhone 17 Pro Max 78.0 × 163.4 mm, Display 1320 × 2868 px (440 × 956 pt),
 * Dynamic Island ≈ 125 × 37 pt, 11 pt unter der Oberkante.
 * Ohne `mobile` steht der iMac allein. Ohne `desktop` (Mini-App ohne Desktop-Ansicht, Joker 2026-11-10)
 * stehen 1–3 iPhones nebeneinander (`screens`) – gleiche Zeichnung, statisch im Raster statt absolut.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  desktop?: ImageMetadata;
  desktopAlt?: string;
  mobile?: ImageMetadata;
  mobileAlt?: string;
  /** Nur ohne `desktop`: 1–3 Hochformat-Screens, je ein iPhone */
  screens?: ImageMetadata[];
  screensAlt?: string[];
  /** `sizes` der Screens – hängt vom Platz der Reihe ab (Projektliste vs. Fallstudie) */
  screenSizes?: string;
  /** Fallstudie: erster Screen eager + fetchpriority high (LCP) */
  priority?: boolean;
  /** Vitrine (Showreel.astro): mehrere Sites übereinander im selben Gerät, je `.screen-layer--n`, alt="".
   *  Ersetzt `desktop`/`mobile`; die Bewegung schreibt die Vitrine. */
  desktopLayers?: ImageMetadata[];
  mobileLayers?: ImageMetadata[];
  layerSizes?: { desktop: string; mobile: string };
  /** Projektliste < 1024 px: lange Aufnahme der Site (`.screen-scroll`), standardmässig ausgeblendet –
   *  ProjectRow blendet sie ein und lässt sie beim Durchscrollen der Zeile laufen. Lazy + display:none
   *  → wird nur geladen, wo sie sichtbar ist. */
  desktopScroll?: ImageMetadata;
  mobileScroll?: ImageMetadata;
}

const {
  desktop,
  desktopAlt = '',
  mobile,
  mobileAlt = '',
  screens,
  screensAlt = [],
  screenSizes = '(max-width: 767px) calc((100vw - 2rem) * 0.31), (max-width: 1439px) 12vw, 160px',
  priority = false,
  desktopLayers,
  mobileLayers,
  layerSizes = { desktop: '50vw', mobile: '12vw' },
  desktopScroll,
  mobileScroll,
} = Astro.props;
const hasDesktop = !!(desktop || desktopLayers?.length);
const hasMobile = !!(mobile || mobileLayers?.length);
---

{!desktop && screens && (
  <div class:list={['phones', `phones--${screens.length}`]}>
    {screens.map((s, i) => (
      <div class="iphone iphone--row">
        <div class="iphone__frame">
          <div class="iphone__glass">
            <div class="iphone__screen">
              <Image
                src={s}
                alt={screensAlt[i] ?? ''}
                widths={[200, 300, 440, 600]}
                sizes={screenSizes}
                loading={priority && i === 0 ? 'eager' : 'lazy'}
                fetchpriority={priority && i === 0 ? 'high' : undefined}
                decoding="async"
                quality={78}
              />
              <span class="iphone__island" aria-hidden="true"></span>
            </div>
          </div>
        </div>
      </div>
    ))}
  </div>
)}

{hasDesktop && (
<div class:list={['devices', { 'devices--solo': !hasMobile }]}>
  <div class="imac">
    <div class="imac__body">
      <div class="imac__glass">
        <div class:list={['imac__screen', { 'screen--lauf': desktopLayers || desktopScroll }]}>
          {desktopLayers ? desktopLayers.map((img, i) => (
            <Image
              src={img}
              alt=""
              class={`screen-layer screen-layer--${i + 1}`}
              widths={[720, 1080, 1440]}
              sizes={layerSizes.desktop}
              loading="lazy"
              decoding="async"
              quality={78}
            />
          )) : desktop && (
            <Image
              src={desktop}
              alt={desktopAlt}
              widths={[400, 560, 840, 1120, 1440]}
              sizes="(max-width: 767px) calc((100vw - 2rem) * 0.8), (max-width: 1439px) 31vw, 450px"
              loading="lazy"
              decoding="async"
              quality={78}
            />
          )}
          {desktopScroll && (
            <Image
              src={desktopScroll}
              alt=""
              class="screen-scroll"
              widths={[400, 720, 1080]}
              sizes="calc((100vw - 2rem) * 0.8)"
              loading="lazy"
              decoding="async"
              quality={78}
            />
          )}
        </div>
      </div>
      <div class="imac__chin"></div>
    </div>
    <div class="imac__neck"></div>
    <div class="imac__foot"></div>
  </div>

  {hasMobile && (
    <div class="iphone">
      <div class="iphone__frame">
        <div class="iphone__glass">
          <div class:list={['iphone__screen', { 'screen--lauf': mobileLayers || mobileScroll }]}>
            {mobileLayers ? mobileLayers.map((img, i) => (
              <Image
                src={img}
                alt=""
                class={`screen-layer screen-layer--${i + 1}`}
                widths={[220, 440]}
                sizes={layerSizes.mobile}
                loading="lazy"
                decoding="async"
                quality={78}
              />
            )) : mobile && (
              <Image
                src={mobile}
                alt={mobileAlt}
                widths={[160, 240, 360, 480]}
                sizes="(max-width: 767px) calc((100vw - 2rem) * 0.2), (max-width: 1439px) 8vw, 110px"
                loading="lazy"
                decoding="async"
                quality={78}
              />
            )}
            {mobileScroll && (
              <Image
                src={mobileScroll}
                alt=""
                class="screen-scroll"
                widths={[220, 440]}
                sizes="calc((100vw - 2rem) * 0.2)"
                loading="lazy"
                decoding="async"
                quality={78}
              />
            )}
            <span class="iphone__island" aria-hidden="true"></span>
          </div>
        </div>
      </div>
    </div>
  )}
</div>
)}

<style>
  /* Das iPhone steht vor dem iMac → seine Unterkante liegt etwas tiefer als der Fuss */
  .devices {
    position: relative;
    padding-bottom: 2.5%;
  }
  .devices :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  /* Laufende Bildschirme (Vitrine, Projektliste mobil): die lange Aufnahme liegt oben bündig in voller
   * Breite und wird per transform verschoben; der Bildschirm ist Container (cqh = seine Höhe), damit
   * „bis zum Ende laufen" translateY(-100% + 100cqh) heisst. Die Bewegung schreiben die Aufrufer. */
  .screen--lauf {
    position: relative;
    container-type: size;
  }
  .screen--lauf :global(.screen-layer),
  .screen--lauf :global(.screen-scroll) {
    position: absolute;
    top: 0;
    left: 0;
    height: auto;
    object-fit: fill;
  }
  .screen--lauf :global(.screen-scroll) { display: none; }

  /* — iMac — */
  .imac { width: 84%; }
  .devices--solo .imac { width: 100%; }
  .imac__body {
    overflow: hidden;
    border: 1px solid var(--hairline-strong);
    border-radius: 1.6% / 2.4%;
    background: var(--device-body);
  }
  .imac__glass {
    padding: 2.5%;
    background: var(--device-glass);
  }
  .imac__screen {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--band);
  }
  .imac__chin {
    aspect-ratio: 100 / 10;
    border-top: 1px solid var(--hairline);
  }
  .imac__neck {
    width: 22%;
    aspect-ratio: 22 / 15;
    margin-inline: auto;
    border-inline: 1px solid var(--hairline-strong);
    background: var(--device-body);
  }
  .imac__foot {
    width: 30%;
    aspect-ratio: 30 / 1.4;
    margin-inline: auto;
    border: 1px solid var(--hairline-strong);
    background: var(--device-body);
  }

  /* — iPhone 17 Pro Max — Rahmen (Aluminium) → schwarzer Glasrand → Display */
  .iphone {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 21%;
  }
  .iphone__frame {
    padding: 1.1%;
    border: 1px solid var(--hairline-strong);
    border-radius: 15% / 7.2%;
    background: var(--device-body);
  }
  .iphone__glass {
    padding: 2.4%;
    border-radius: 14% / 6.7%;
    background: var(--device-glass);
  }
  .iphone__screen {
    position: relative;
    aspect-ratio: 1320 / 2868;
    overflow: hidden;
    border-radius: 12.5% / 5.75%;
    background: var(--band);
  }
  .iphone__island {
    position: absolute;
    top: 1.15%;
    left: 50%;
    width: 28.4%;
    aspect-ratio: 125 / 37;
    transform: translateX(-50%);
    border-radius: 100vmax;
    background: var(--device-glass);
  }

  /* — iPhone-Reihe (ohne Desktop) — gleiche Zeichnung, statisch im Raster; Masse in % der Spalte */
  .phones {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 4%;
    align-items: end;
  }
  .phones--1 { grid-template-columns: minmax(0, 1fr); width: 40%; }
  .phones--2 { grid-template-columns: repeat(2, minmax(0, 1fr)); width: 70%; }
  .phones :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }
  .iphone--row {
    position: static;
    width: auto;
  }
</style>
