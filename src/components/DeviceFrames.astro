---
/**
 * Geräte-Komposition der Projektliste (Joker, 2026-11-09): iMac 24" hinten, iPhone 17 Pro Max
 * vorne rechts, überlappend. Flach gezeichnet – eloxiertes Gehäuse, Hairlines, keine Schatten,
 * kein Bild-Mockup. Alle Masse in % der Breite → skaliert mit der Spalte, ohne Breakpoint.
 *
 * Proportionen (Apple-Datenblätter): iMac 24" 54.7 cm breit, Glasrand ≈ 1.35 cm, Display 16:9;
 * iPhone 17 Pro Max 78.0 × 163.4 mm, Display 1320 × 2868 px (440 × 956 pt),
 * Dynamic Island ≈ 125 × 37 pt, 11 pt unter der Oberkante.
 * Ohne `mobile` steht der iMac allein.
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  desktop: ImageMetadata;
  desktopAlt: string;
  mobile?: ImageMetadata;
  mobileAlt: string;
}

const { desktop, desktopAlt, mobile, mobileAlt } = Astro.props;
---

<div class:list={['devices', { 'devices--solo': !mobile }]}>
  <div class="imac">
    <div class="imac__body">
      <div class="imac__glass">
        <div class="imac__screen">
          <Image
            src={desktop}
            alt={desktopAlt}
            widths={[400, 560, 840, 1120, 1440]}
            sizes="(max-width: 767px) calc((100vw - 2rem) * 0.8), (max-width: 1439px) 31vw, 450px"
            loading="lazy"
            decoding="async"
            quality={78}
          />
        </div>
      </div>
      <div class="imac__chin"></div>
    </div>
    <div class="imac__neck"></div>
    <div class="imac__foot"></div>
  </div>

  {mobile && (
    <div class="iphone">
      <div class="iphone__frame">
        <div class="iphone__glass">
          <div class="iphone__screen">
            <Image
              src={mobile}
              alt={mobileAlt}
              widths={[160, 240, 360, 480]}
              sizes="(max-width: 767px) calc((100vw - 2rem) * 0.2), (max-width: 1439px) 8vw, 110px"
              loading="lazy"
              decoding="async"
              quality={78}
            />
            <span class="iphone__island" aria-hidden="true"></span>
          </div>
        </div>
      </div>
    </div>
  )}
</div>

<style>
  /* Das iPhone steht vor dem iMac → seine Unterkante liegt etwas tiefer als der Fuss */
  .devices {
    position: relative;
    padding-bottom: 2.5%;
  }
  .devices :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top center;
  }

  /* — iMac — */
  .imac { width: 84%; }
  .devices--solo .imac { width: 100%; }
  .imac__body {
    overflow: hidden;
    border: 1px solid var(--hairline-strong);
    border-radius: 1.6% / 2.4%;
    background: var(--device-body);
  }
  .imac__glass {
    padding: 2.5%;
    background: var(--device-glass);
  }
  .imac__screen {
    aspect-ratio: 16 / 9;
    overflow: hidden;
    background: var(--band);
  }
  .imac__chin {
    aspect-ratio: 100 / 10;
    border-top: 1px solid var(--hairline);
  }
  .imac__neck {
    width: 22%;
    aspect-ratio: 22 / 15;
    margin-inline: auto;
    border-inline: 1px solid var(--hairline-strong);
    background: var(--device-body);
  }
  .imac__foot {
    width: 30%;
    aspect-ratio: 30 / 1.4;
    margin-inline: auto;
    border: 1px solid var(--hairline-strong);
    background: var(--device-body);
  }

  /* — iPhone 17 Pro Max — Rahmen (Aluminium) → schwarzer Glasrand → Display */
  .iphone {
    position: absolute;
    right: 0;
    bottom: 0;
    width: 21%;
  }
  .iphone__frame {
    padding: 1.1%;
    border: 1px solid var(--hairline-strong);
    border-radius: 15% / 7.2%;
    background: var(--device-body);
  }
  .iphone__glass {
    padding: 2.4%;
    border-radius: 14% / 6.7%;
    background: var(--device-glass);
  }
  .iphone__screen {
    position: relative;
    aspect-ratio: 1320 / 2868;
    overflow: hidden;
    border-radius: 12.5% / 5.75%;
    background: var(--band);
  }
  .iphone__island {
    position: absolute;
    top: 1.15%;
    left: 50%;
    width: 28.4%;
    aspect-ratio: 125 / 37;
    transform: translateX(-50%);
    border-radius: 100vmax;
    background: var(--device-glass);
  }
</style>
